    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.12.0"
  },
  "keywords": [
    "papido",
    "survey",
    "booking",
    "feedback",
    "react",
    "express",
    "tidb",
