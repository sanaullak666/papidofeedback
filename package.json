{
  "name": "papido-booking-opinion-survey",
  "version": "1.0.0",
  "type": "module",
  "description": "Production-ready standalone opinion survey platform for Papido ride booking (Vercel Serverless + TiDB Cloud)",
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "node test-e2e.js",
    "dev:server": "cd server && npm run dev",
