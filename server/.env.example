# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (MySQL / TiDB Cloud)
# For local MySQL:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=papido_survey_db

# For TiDB Cloud Serverless:
DB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_tidb_user
DB_PASSWORD=your_tidb_password
DB_NAME=papido_survey_db
DB_SSL=true
DB_CONNECTION_LIMIT=10

# Or using complete connection string:
# DATABASE_URL=mysql://user:pass@host:4000/papido_survey_db?ssl={"rejectUnauthorized":true}

# Security & JWT
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_at_least_32_characters
JWT_EXPIRES_IN=7d

# Rate Limiting
SUBMIT_RATE_LIMIT_WINDOW_MS=900000
SUBMIT_RATE_LIMIT_MAX=20

# Initial Admin Credentials (Seeded on first run if no admin exists)
ADMIN_DEFAULT_EMAIL=admin@papido.online
ADMIN_DEFAULT_PASSWORD=Admin@Papido2026!
ADMIN_DEFAULT_NAME=Papido Administrator

# Configurable Website Link
NEW_BOOKING_WEBSITE_URL=https://www.papido.online
